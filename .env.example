# Application
NODE_ENV=development
APP_NAME=ContentFlow AI

# Backend
PORT=4000
API_URL=http://localhost:4000
CORS_ORIGIN=http://localhost:3000
SESSION_SECRET=change-me-to-a-long-random-string-in-production
JWT_SECRET=change-me-jwt-secret-min-32-chars-long!!

# Database (Docker Compose defaults)
DATABASE_URL=postgresql://contentflow:contentflow@localhost:5432/contentflow?schema=public

# Redis (Docker Compose defaults)
REDIS_URL=redis://localhost:6379

# File storage (local paths relative to backend/)
UPLOAD_DIR=./storage/uploads
ASSET_DIR=./storage/assets
MAX_UPLOAD_BYTES=524288000

# FFmpeg (must be on PATH or set full path)
FFMPEG_PATH=ffmpeg

# Transcription — Python faster-whisper script
PYTHON_PATH=python
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional demo mode when Ollama/Whisper unavailable (labeled in API responses)
DEMO_MODE=false

# Social OAuth (optional — leave empty until configured)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:4000/api/social/linkedin/callback

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:4000/api/social/x/callback

META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:4000/api/social/instagram/callback

# Token encryption (32-byte hex or any string hashed to 32 bytes)
TOKEN_ENCRYPTION_KEY=dev-token-encryption-key-32b!!

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
